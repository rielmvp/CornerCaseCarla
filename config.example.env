# Copy to .env and adjust. Read by every script and by cornercase/paths.py.
# Relative paths are taken from the repo root.

# Where things are
CARLA_ROOT=carla/CARLA_0.9.16          # CARLA 0.9.16 server (scripts/get_carla.sh)
CKPT_ROOT=checkpoints                  # Alpamayo weights (scripts/download_models.sh)

# Which GPU: CUDA index for Alpamayo, Vulkan adapter index for CARLA. These usually
# match; if CARLA lands on another card, set CARLA_ADAPTER separately.
GPU=0
# CARLA_ADAPTER=0
CARLA_PORT=2000

# Live studio
MODELS=1,1.5                           # Alpamayo versions the worker keeps loaded (~22 GB each)
DEMO_PORT=8900
# BIND_HOST=127.0.0.1                  # 0.0.0.0 opens the page to your local network
# Basic auth for the studio page; required when TUNNEL is on.
# DEMO_USER=demo
# DEMO_PASS=change-me
# TUNNEL=quick                         # expose through a Cloudflare quick tunnel (no account)
# CLOUDFLARED=cloudflared              # path to the cloudflared binary (see README: Show it to someone else)

# Optional: keep a stable public URL with the Worker in deploy/ (your own Cloudflare account).
# The demo writes each new quick-tunnel URL into this KV namespace.
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_KV_TOKEN=                         # API token with Workers KV Storage:Edit only

# Hugging Face: the Alpamayo 1.5 processor comes from the gated nvidia/Cosmos-Reason2-8B.
# After scripts/download_models.sh has filled the cache, run offline.
HF_HUB_OFFLINE=1
